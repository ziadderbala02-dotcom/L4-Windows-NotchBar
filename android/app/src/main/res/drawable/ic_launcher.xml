            <solid android:color="#FF000000" />
            <stroke android:width="1dp" android:color="#FF34D399" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:top="25dp" android:bottom="25dp" android:gravity="center" android:width="7dp" android:height="7dp">
        <shape android:shape="oval">
            <solid android:color="#FF34D399" />
        </shape>
    </item>
</layer-list>
